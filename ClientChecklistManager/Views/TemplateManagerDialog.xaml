<Window x:Class="ClientChecklistManager.Views.TemplateManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load from Template"
        Height="450" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a template to load:" FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Template list -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Templates}"
                     SelectedItem="{Binding SelectedTemplate}"
                     DisplayMemberPath="Name"
                     BorderBrush="#D1D5DB" BorderThickness="1" />

            <!-- Template items preview -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Items in template:" FontSize="12"
                           Foreground="#6B7280" Margin="0,0,0,6" />
                <ListView ItemsSource="{Binding SelectedTemplateItems}"
                          BorderBrush="#D1D5DB" BorderThickness="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Delete Template" Style="{StaticResource DangerButton}"
                    Command="{Binding DeleteTemplateCommand}" Margin="0,0,8,0" />
            <Button Content="Close" Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" Margin="0,0,8,0" />
            <Button Content="Load Selected"
                    Click="LoadSelected_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="IsEnabled" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTemplate}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
